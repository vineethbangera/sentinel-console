# Bastion's packages come from GitHub Packages; everything else from npmjs.
# GitHub Packages needs a token to install, even public packages. The token
# comes from the environment and is never written here:
#   export NODE_AUTH_TOKEN=$(gh auth token)
@vineethbangera:registry=https://npm.pkg.github.com
//npm.pkg.github.com/:_authToken=${NODE_AUTH_TOKEN}
